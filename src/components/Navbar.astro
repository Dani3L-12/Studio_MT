---
import { siteConfig } from '../config/site.config';
import { es } from '../i18n/es';
import Logo from './Logo.astro';
import Button from './Button.astro';

const t = es;

const currentPath = Astro.url.pathname;

// Base URL del repositorio configurada en astro.config.mjs
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Helper to determine if nav link is active
const isActive = (path: string) => {
  const cleanPath = currentPath.replace(baseUrl, '');
  if (path === '/') {
    return cleanPath === '/' || cleanPath === '';
  }
  return cleanPath.includes(path);
};

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md border-b transition-colors duration-300" style="border-color: var(--card-dark-border); background-color: var(--card-dark-bg);">
  <div class="w-full px-6 md:px-12 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <Logo />

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-6 font-medium text-sm" aria-label="Navegación principal">
      <a href={`${baseUrl}/`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.home}</a>
      <a href={`${baseUrl}/servicios`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/servicios') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.services}</a>
      <a href={`${baseUrl}/demos`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/demos') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.demos}</a>
      <a href={`${baseUrl}/paquetes`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/paquetes') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.packages}</a>
      <a href={`${baseUrl}/nosotros`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/nosotros') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.about}</a>
      <a href={`${baseUrl}/contacto`} class={`transition-colors hover:text-[var(--brand-fg)] ${isActive('/contacto') ? 'text-[var(--brand-fg)] font-bold border-b-2 border-[var(--brand-fg)] pb-1' : ''}`}>{t.nav.contact}</a>
    </nav>

    <!-- Actions (Theme Toggle, WhatsApp CTA, Mobile Menu Button) -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle Button -->
      <button 
        id="theme-toggle" 
        type="button" 
        class="p-2.5 rounded-xl glass-card hover:border-[var(--brand-fg)] transition-all cursor-pointer"
        aria-label={t.common.darkModeToggle}
      >
        <!-- Sun icon (dark mode) -->
        <svg class="w-5 h-5 hidden dark:block text-[var(--brand-fg)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <!-- Moon icon (light mode) -->
        <svg class="w-5 h-5 block dark:hidden text-[#053B2A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Primary Desktop CTA -->
      <div class="hidden md:block">
        <Button variant="primary" href={whatsappUrl} class="text-xs px-4 py-2.5">
          {t.nav.ctaWhatsApp}
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="menu-btn" 
        type="button" 
        class="lg:hidden p-2.5 rounded-xl glass-card hover:border-[var(--brand-fg)] transition-all cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Full-screen Glass Panel -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 z-50 bg-[#070B0A]/90 dark:bg-[#070B0A]/95 backdrop-blur-xl hidden flex flex-col justify-between p-8"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex items-center justify-between">
      <Logo />
      <button 
        id="menu-close-btn" 
        type="button" 
        class="p-3 rounded-xl glass-card hover:border-[var(--brand-fg)] text-white cursor-pointer"
        aria-label="Cerrar menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col items-center gap-6 text-xl font-bold font-['Space_Grotesk']" aria-label="Navegación móvil">
      <a href={`${baseUrl}/`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.home}</a>
      <a href={`${baseUrl}/servicios`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.services}</a>
      <a href={`${baseUrl}/demos`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.demos}</a>
      <a href={`${baseUrl}/paquetes`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.packages}</a>
      <a href={`${baseUrl}/nosotros`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.about}</a>
      <a href={`${baseUrl}/contacto`} class="hover:text-[var(--brand-fg)] transition-colors">{t.nav.contact}</a>
    </nav>

    <div class="flex flex-col gap-4">
      <Button variant="primary" href={whatsappUrl} class="w-full justify-center py-3 text-sm">
        {t.nav.ctaWhatsApp}
      </Button>
    </div>
  </div>
</header>

<script>
  // Theme Toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile Menu handling
  const menuBtn = document.getElementById('menu-btn');
  const menuCloseBtn = document.getElementById('menu-close-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  const openMenu = () => {
    mobileMenu?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    menuCloseBtn?.focus();
  };

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    menuBtn?.focus();
  };

  menuBtn?.addEventListener('click', openMenu);
  menuCloseBtn?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>
