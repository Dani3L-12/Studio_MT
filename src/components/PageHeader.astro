---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="relative pt-16 pb-12 px-6 text-center max-w-4xl mx-auto">
  <div class="absolute inset-0 bg-gradient-to-r from-[#39FF14]/5 to-[#00E5C3]/5 rounded-3xl blur-3xl -z-10"></div>
  <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 font-['Space_Grotesk']">
    {title}
  </h1>
  <p class="text-base md:text-lg opacity-80 leading-relaxed max-w-2xl mx-auto">
    {subtitle}
  </p>
</div>
