---
import Section from './Section.astro';
import {
  PRICING_PLANS,
  PRICING_TITLE,
  PRICING_SUBTITLE,
  PRICING_MOST_POPULAR,
  PRICING_HELP_TEXT,
  PRICING_HELP_CTA,
  PRICING_HELP_MESSAGE,
  PRICING_SUPPORT_TEXT,
  WHATSAPP_NUMBER,
} from '../data/pricing';

const waLink = (message: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

const checkIcon = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />`;
---

<Section title={PRICING_TITLE} subtitle={PRICING_SUBTITLE}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12 items-stretch">
    {PRICING_PLANS.map((plan) => (
      <article class={`pricing-card ${plan.popular ? 'pricing-card-popular max-md:order-first' : ''}`}>
        {plan.popular && (
          <div class="mb-5">
            <span class="inline-flex items-center rounded-full bg-[var(--brand)] px-3 py-1 font-mono text-xs font-bold text-[#070B0A] shadow-[0_0_18px_var(--brand-glow)]">
              {PRICING_MOST_POPULAR}
            </span>
          </div>
        )}

        <p class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.2em] text-[var(--brand-fg)] mb-2">
          {plan.label}
        </p>
        <p class="text-sm md:text-[15px] opacity-80 mb-5">{plan.tagline}</p>

        <p class="text-5xl font-extrabold font-['Space_Grotesk'] tracking-tight mb-1">
          {plan.price}
        </p>
        <p class="text-xs opacity-70 mb-5">{plan.priceNote}</p>

        <p class="flex items-center gap-2 text-sm font-semibold mb-6 text-[var(--brand-fg)]">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" />
          </svg>
          Entrega en {plan.deliveryDays} días
        </p>

        <ul class="space-y-4 text-[15px] md:text-base leading-relaxed flex-1 mb-8">
          {plan.features.map((feat) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5 text-[var(--brand-fg)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={checkIcon} />
              <span class={feat.bold ? 'font-bold' : ''}>{feat.text}</span>
            </li>
          ))}
        </ul>

        <a
          href={waLink(plan.waMessage)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${plan.cta}: cotizar el plan ${plan.label} por WhatsApp`}
          class={`mt-auto inline-flex w-full items-center justify-center rounded-xl px-6 py-3.5 font-bold transition-all duration-300 active:scale-95 ${
            plan.popular
              ? 'bg-[var(--brand)] text-[#070B0A] shadow-[0_0_20px_var(--brand-glow)] hover:shadow-[0_0_28px_var(--brand-glow)] hover:brightness-95'
              : 'border-[1.5px] border-[var(--brand-fg)] text-[var(--brand-fg)] hover:bg-[var(--brand)] hover:border-[var(--brand)] hover:text-[#070B0A] hover:shadow-[0_0_24px_var(--brand-glow)]'
          }`}
        >
          {plan.cta}
        </a>
      </article>
    ))}
  </div>

  <!-- Franja: ¿no sabes cuál elegir? -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <p class="text-base md:text-lg font-medium mb-5">{PRICING_HELP_TEXT}</p>
    <a
      href={waLink(PRICING_HELP_MESSAGE)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escribir por WhatsApp para recibir una recomendación de plan"
      class="inline-flex items-center justify-center rounded-xl border-[1.5px] border-[var(--brand-fg)] px-8 py-3.5 font-bold text-[var(--brand-fg)] transition-all duration-300 hover:bg-[var(--brand)] hover:border-[var(--brand)] hover:text-[#070B0A] hover:shadow-[0_0_24px_var(--brand-glow)] active:scale-95"
    >
      {PRICING_HELP_CTA}
    </a>
  </div>

  <!-- Banda de soporte mensual -->
  <div class="pricing-card max-w-3xl mx-auto">
    <div class="flex items-center gap-4">
      <span class="flex w-12 h-12 shrink-0 items-center justify-center rounded-xl bg-[var(--brand)]/15 text-[var(--brand-fg)]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 2.8v5.1c0 4.9-3.4 7.8-7 9.1-3.6-1.3-7-4.2-7-9.1V5.8L12 3z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9.5 12l2 2 3.5-4" />
        </svg>
      </span>
      <p class="text-sm md:text-[15px] font-medium leading-relaxed">{PRICING_SUPPORT_TEXT}</p>
    </div>
  </div>
</Section>
