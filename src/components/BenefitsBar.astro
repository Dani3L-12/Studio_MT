---
import { es } from '../i18n/es';
import { en } from '../i18n/en';
import GlassCard from './GlassCard.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;

const benefitsList = [
  {
    title: t.benefits.item1Title,
    desc: t.benefits.item1Desc,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    title: t.benefits.item2Title,
    desc: t.benefits.item2Desc,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`
  },
  {
    title: t.benefits.item3Title,
    desc: t.benefits.item3Desc,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`
  },
  {
    title: t.benefits.item4Title,
    desc: t.benefits.item4Desc,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`
  }
];
---

<section class="py-12 px-6 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {benefitsList.map(item => (
      <GlassCard class="flex flex-col items-start text-left hover:border-[#00E5C3] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#39FF14]/20 to-[#00E5C3]/20 flex items-center justify-center text-[#00E5C3] mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
        </div>
        <h3 class="font-bold text-lg mb-2 font-['Space_Grotesk']">{item.title}</h3>
        <p class="text-xs sm:text-sm opacity-75 leading-relaxed">{item.desc}</p>
      </GlassCard>
    ))}
  </div>
</section>
