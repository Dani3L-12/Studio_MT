---
import { siteConfig } from '../config/site.config';
import { es } from '../i18n/es';
import { en } from '../i18n/en';
import Logo from './Logo.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = lang === 'en' ? en : es;
const isEnglish = lang === 'en';

const prefix = isEnglish ? '/en' : '';
---

<footer class="mt-20 border-t border-[var(--card-dark-border)] backdrop-blur-md bg-[var(--card-dark-bg)] py-16 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
    <!-- Brand & Slogan -->
    <div class="space-y-4">
      <Logo />
      <p class="text-sm opacity-75 leading-relaxed">
        {t.footer.slogan}
      </p>
    </div>

    <!-- Navigation Column -->
    <div>
      <h4 class="font-bold text-sm uppercase tracking-wider mb-4 font-['Space_Grotesk'] text-[#00E5C3]">
        {t.footer.navigation}
      </h4>
      <ul class="space-y-3 text-sm opacity-80 font-medium">
        <li><a href={`${prefix}/`} class="hover:text-[#00E5C3] transition-colors">{t.nav.home}</a></li>
        <li><a href={`${prefix}/servicios`} class="hover:text-[#00E5C3] transition-colors">{t.nav.services}</a></li>
        <li><a href={`${prefix}/demos`} class="hover:text-[#00E5C3] transition-colors">{t.nav.demos}</a></li>
        <li><a href={`${prefix}/paquetes`} class="hover:text-[#00E5C3] transition-colors">{t.nav.packages}</a></li>
        <li><a href={`${prefix}/nosotros`} class="hover:text-[#00E5C3] transition-colors">{t.nav.about}</a></li>
        <li><a href={`${prefix}/contacto`} class="hover:text-[#00E5C3] transition-colors">{t.nav.contact}</a></li>
      </ul>
    </div>

    <!-- Legal Column -->
    <div>
      <h4 class="font-bold text-sm uppercase tracking-wider mb-4 font-['Space_Grotesk'] text-[#00E5C3]">
        {t.footer.legal}
      </h4>
      <ul class="space-y-3 text-sm opacity-80 font-medium">
        <li><a href={`${prefix}/privacidad`} class="hover:text-[#00E5C3] transition-colors">{t.nav.privacy}</a></li>
        <li><a href={`${prefix}/terminos`} class="hover:text-[#00E5C3] transition-colors">{t.nav.terms}</a></li>
      </ul>
    </div>

    <!-- Contact & Social Column -->
    <div class="space-y-4">
      <h4 class="font-bold text-sm uppercase tracking-wider mb-4 font-['Space_Grotesk'] text-[#00E5C3]">
        {t.footer.contactTitle}
      </h4>
      <p class="text-sm opacity-85">WhatsApp: <span class="font-mono text-[#39FF14]">+{siteConfig.whatsappNumber}</span></p>
      <p class="text-sm opacity-85">Email: <span class="font-mono">{siteConfig.email}</span></p>
      <div class="flex items-center gap-4 pt-2">
        <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg glass-card hover:border-[#00E5C3] transition-all" aria-label="Facebook">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg glass-card hover:border-[#00E5C3] transition-all" aria-label="Instagram">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href={siteConfig.socialLinks.tiktok} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg glass-card hover:border-[#00E5C3] transition-all" aria-label="TikTok">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto pt-8 border-t border-[var(--card-dark-border)] flex flex-col sm:flex-row items-center justify-between text-xs opacity-75 gap-4">
    <p>© {new Date().getFullYear()} {siteConfig.brandName}. {t.footer.rights}</p>
    <p>{t.footer.builtBy}</p>
  </div>
</footer>
