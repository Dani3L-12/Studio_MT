---
import { siteConfig } from '../config/site.config';

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
// Para cambiar la foto, guarda la imagen en src/assets/ y completa profilePhoto en site.config.ts
const hasPhoto = Boolean(siteConfig.profilePhoto && siteConfig.profilePhoto.trim() !== "");
---

<div class={`relative rounded-full overflow-hidden border-2 border-[#00E5C3]/40 shadow-xl flex items-center justify-center bg-[var(--card-dark-bg)] ${className}`}>
  {hasPhoto ? (
    <img src={siteConfig.profilePhoto} alt={`Foto de ${siteConfig.ownerName}, ${siteConfig.brandName}`} class="w-full h-full object-cover" />
  ) : (
    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#053B2A] to-[#070B0A] text-[#00E5C3]">
      <svg class="w-16 h-16 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
    </div>
  )}
</div>
