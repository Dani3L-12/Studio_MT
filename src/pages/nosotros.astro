---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import GlassCard from '../components/GlassCard.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { siteConfig } from '../config/site.config';
import { es } from '../i18n/es';

const valueProps = [
  { title: es.benefits.item1Title, desc: es.benefits.item1Desc, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />` },
  { title: es.benefits.item2Title, desc: es.benefits.item2Desc, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />` },
  { title: es.benefits.item3Title, desc: es.benefits.item3Desc, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />` },
  { title: es.benefits.item4Title, desc: es.benefits.item4Desc, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />` }
];

const valuesList = [
  { title: es.aboutPage.val1Title, desc: es.aboutPage.val1Desc },
  { title: es.aboutPage.val2Title, desc: es.aboutPage.val2Desc },
  { title: es.aboutPage.val3Title, desc: es.aboutPage.val3Desc }
];
---

<Layout lang="es" title={es.pages.about.title} description={es.pages.about.subtitle}>
  <PageHeader title={es.aboutPage.headerTitle} subtitle={es.aboutPage.headerSubtitle} />

  <Section>
    <!-- PRESENTACIÓN DE DANIEL -->
    <div class="max-w-2xl mx-auto mb-20">
      <GlassCard class="p-8 md:p-12 text-center flex flex-col items-center">
        <ProfilePhoto class="w-32 h-32 mb-6" />
        <h2 class="text-3xl font-bold font-['Space_Grotesk'] mb-1">{siteConfig.ownerName}</h2>
        <div class="text-xs font-mono text-[#00E5C3] font-bold uppercase tracking-wider mb-6">{es.aboutPage.founderRole}</div>
        <p class="text-sm md:text-base opacity-85 leading-relaxed mb-8">
          {es.aboutPage.bio}
        </p>

        <!-- Social links -->
        <div class="flex items-center gap-4">
          <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl glass-card hover:border-[#00E5C3] transition-all" aria-label="Facebook">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl glass-card hover:border-[#00E5C3] transition-all" aria-label="Instagram">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href={siteConfig.socialLinks.tiktok} target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl glass-card hover:border-[#00E5C3] transition-all" aria-label="TikTok">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
          </a>
        </div>
      </GlassCard>
    </div>

    <!-- PROPUESTA DE VALOR -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-3 font-['Space_Grotesk']">
          {es.aboutPage.valuePropTitle}
        </h2>
        <p class="text-sm md:text-base opacity-80">{es.aboutPage.valuePropSubtitle}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
        {valueProps.map(item => (
          <GlassCard class="flex flex-col items-start text-left">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#39FF14]/20 to-[#00E5C3]/20 flex items-center justify-center text-[#00E5C3] mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </div>
            <h3 class="font-bold text-lg mb-2 font-['Space_Grotesk']">{item.title}</h3>
            <p class="text-xs sm:text-sm opacity-75 leading-relaxed">{item.desc}</p>
          </GlassCard>
        ))}
      </div>
    </div>

    <!-- CÓMO TRABAJAMOS -->
    <div class="mb-20">
      <ProcessSection lang="es" />
    </div>

    <!-- VALORES -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-3 font-['Space_Grotesk']">
          {es.aboutPage.valuesTitle}
        </h2>
        <p class="text-sm md:text-base opacity-80">{es.aboutPage.valuesSubtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {valuesList.map((val, i) => (
          <GlassCard class="p-8 flex flex-col items-start text-left">
            <div class="text-[#39FF14] font-mono font-bold text-lg mb-3">0{i + 1}</div>
            <h3 class="font-bold text-xl mb-2 font-['Space_Grotesk']">{val.title}</h3>
            <p class="text-sm opacity-75 leading-relaxed">{val.desc}</p>
          </GlassCard>
        ))}
      </div>
    </div>

    <!-- TESTIMONIOS (condicionales) -->
    <TestimonialsSection lang="es" />

  </Section>

  <CtaSection lang="es" />
</Layout>
