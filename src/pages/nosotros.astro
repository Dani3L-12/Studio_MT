---
import { existsSync } from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TechCarousel from '../components/TechCarousel.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { nosotrosHeader, teamMembers } from '../data/nosotros';
import { es } from '../i18n/es';

// Prefijo del subdirectorio de despliegue ('' en raíz, '/Studio_MT' en GitHub Pages)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// La foto se muestra solo si el archivo existe en /public; si no, iniciales.
const hasFoto = (foto: string) =>
  existsSync(path.join(process.cwd(), 'public', foto.replace(/^\/+/, '')));

---

<Layout title={es.pages.about.title} description={es.pages.about.subtitle}>
  <PageHeader title={nosotrosHeader.title} subtitle={nosotrosHeader.subtitle} />

  <Section>
    <!-- EQUIPO -->
    <div class="team-grid">
      {teamMembers.map((member) => {
        const fotoSrc = member.foto.startsWith('/') ? `${baseUrl}${member.foto}` : member.foto;
        return (
          <article class="team-card">
            {hasFoto(member.foto) ? (
              <img
                class="team-avatar"
                src={fotoSrc}
                alt={member.nombre}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="team-avatar team-avatar--fallback" role="img" aria-label={member.nombre}>
                {member.iniciales}
              </span>
            )}
            <h2 class="team-name">{member.nombre}</h2>
            <p class="team-formacion">{member.formacion}</p>
            <p class="team-rol">{member.rol}</p>
            <p class="team-desc">{member.descripcion}</p>
            <ul class="team-chips">
              {member.chips.map((chip) => (
                <li class="team-chip">{chip}</li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    <!-- CARRUSEL DE TECNOLOGÍAS -->
    <TechCarousel />

    <!-- CÓMO TRABAJAMOS -->
    <div class="mt-block mb-block">
      <ProcessSection />
    </div>

    <!-- VALORES -->
    <div class="mb-block">
      <div class="text-center max-w-2xl mx-auto mb-head">
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-3 font-['Space_Grotesk']">
          {es.aboutPage.valuesTitle}
        </h2>
        <p class="text-sm md:text-base opacity-80">{es.aboutPage.valuesSubtitle}</p>
      </div>

      <ul class="values-list">
        {es.aboutPage.valuesData.map((val) => (
          <li class="value-row">
            <span class="value-num">{val.numero}</span>
            <h3 class="value-name">{val.nombre}</h3>
            <div class="value-text">
              <p class="value-frase">{val.frase}</p>
              <p class="value-detalle">{val.detalle}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- TESTIMONIOS (condicionales) -->
    <TestimonialsSection />

  </Section>

  <CtaSection />
</Layout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-block);
    max-width: 1000px;
    margin: 0 auto var(--space-block);
  }

  @media (min-width: 800px) {
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    padding: 32px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.04), transparent 60%);
    transition: border-color 250ms ease;
  }

  .team-card:hover {
    border-color: color-mix(in srgb, var(--brand) 35%, transparent);
  }

  .team-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
  }

  .team-avatar--fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0a0e0d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--brand-fg);
    font-size: 28px;
    font-weight: 700;
  }

  .team-name {
    margin: 0 0 6px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    color: #ffffff;
  }

  .team-formacion {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }

  .team-rol {
    margin: 0 0 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-fg);
  }

  .team-desc {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .team-chips {
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .team-chip {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.75);
  }

  .values-list {
    margin: 0 auto;
    padding: 0;
    list-style: none;
    max-width: 1000px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .value-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    align-items: start;
    padding: calc(var(--space-block) + 8px) 0;
  }

  .value-row + .value-row {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .value-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--brand);
    transform: scaleY(0);
    transition: transform 250ms ease;
  }

  .value-row:hover::before {
    transform: scaleY(1);
  }

  .value-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--brand-fg);
  }

  .value-name {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    color: #ffffff;
    transition: color 250ms ease;
  }

  .value-row:hover .value-name {
    color: var(--brand-fg);
  }

  .value-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .value-frase {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    color: #ffffff;
  }

  .value-detalle {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    max-width: 520px;
  }

  @media (min-width: 900px) {
    .value-row {
      grid-template-columns: 80px 1fr 1.4fr;
      column-gap: 32px;
    }

    .value-name {
      font-size: clamp(36px, 4vw, 40px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-row::before {
      transform: none;
      opacity: 0;
    }
    .value-row:hover::before {
      opacity: 1;
    }
  }
</style>
