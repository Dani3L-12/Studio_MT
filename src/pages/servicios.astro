---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { WHATSAPP_NUMBER } from '../data/pricing';

// Prefijo del subdirectorio de despliegue ('' en raíz, '/Studio_MT' en GitHub Pages)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
    {
      id: 'carta-digital',
      number: '01',
      title: 'Carta digital',
      description: 'Tu menú en una web que se abre con un QR. Tus clientes ven platos, fotos y precios, y te hacen el pedido directo por WhatsApp.',
      idealFor: ['Restaurantes', 'Cafeterías', 'Pollerías', 'Comida'],
      includes: [
        'Menú por categorías',
        'Fotos de tus platos',
        'Precios actualizables',
        'Pedidos por WhatsApp',
        'QR para imprimir',
        'Diseño para celular'
      ],
    image: '/images/services/carta.webp',
      imageAlt: 'Captura de una carta digital en un celular mostrando un menú de restaurante con platos, precios y botón de WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Carta digital para mi negocio. ¿Me das más información?'
    },
    {
      id: 'landing-page',
      number: '02',
      title: 'Landing page',
      description: 'Una página clara y rápida que presenta tu negocio, muestra tus servicios y lleva al cliente a escribirte o reservar.',
      idealFor: ['Barberías', 'Gimnasios', 'Consultorios', 'Academias'],
      includes: [
        'Portada con propuesta',
        'Servicios y precios',
        'Galería de trabajos',
        'WhatsApp directo',
        'Mapa y horarios',
        'Diseño para celular'
      ],
    image: '/images/services/landing.webp',
      imageAlt: 'Captura de una landing page para una barbería mostrando servicios, precios y botón de WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Landing page para mi negocio. ¿Me das más información?'
    },
    {
      id: 'catalogo-web',
      number: '03',
      title: 'Catálogo web',
      description: 'Muestra tus productos en una web ordenada y recibe consultas al instante, sin que el cliente tenga que preguntar "¿qué tienes?".',
      idealFor: ['Ropa', 'Ferreterías', 'Joyerías', 'Artesanías'],
      includes: [
        'Hasta ~30 productos',
        'Categorías rápidas',
        'Foto, precio y detalle',
        'Consulta por WhatsApp',
        'SEO básico',
        'Diseño para celular'
      ],
      image: '/images/services/catalogo.webp',
      imageAlt: 'Captura de un catálogo web mostrando productos en categorías con fotos y precios',
      whatsappMessage: 'Hola, me interesa el servicio de Catálogo web para mi negocio. ¿Me das más información?'
    },
    {
      id: 'tienda-whatsapp',
      number: '04',
      title: 'Tienda con WhatsApp',
      description: 'Un carrito simple que termina en un mensaje de pedido armado en tu WhatsApp. Sin comisiones ni pasarelas complicadas.',
      idealFor: ['Delivery', 'Boutiques', 'Regalos', 'Ventas por pedido'],
      includes: [
        'Catálogo con carrito',
        'Total automático',
        'Pedido por WhatsApp',
        'Delivery o recojo',
        'Español e inglés',
        'Capacitación por Meet'
      ],
    image: '/images/services/tienda.webp',
      imageAlt: 'Captura de una tienda con carrito mostrando productos, cantidades y botón de pedido por WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Tienda con WhatsApp para mi negocio. ¿Me das más información?'
    }
  ] as const;

  const whatsappUrl = (message: string) =>
    `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
---

<Layout title="Servicios" description="Webs simples, rápidas y pensadas para que tus clientes te escriban directo por WhatsApp.">
  <PageHeader title="Servicios" subtitle="Webs simples, rápidas y pensadas para que tus clientes te escriban directo por WhatsApp." />

  <!-- ANCHOR NAV -->
  <nav class="flex flex-wrap justify-center gap-3 mt-section mb-block" aria-label="Navegación de servicios">
    {services.map((svc) => {
      return (
        <a
          href={`#${svc.id}`}
          class="chip px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 hover:bg-[var(--brand-soft)] hover:text-[var(--brand-fg)] focus:outline-none focus:ring-2 focus:ring-[var(--brand-fg)] focus:ring-offset-2 focus:ring-[#070B0A]"
          data-target={svc.id}
        >
          {svc.title}
        </a>
      );
    })}
  </nav>

<!-- Service Rows -->
<div class="mx-auto flex max-w-[1100px] flex-col gap-10 md:gap-12" id="services-grid" role="list" aria-label="Servicios disponibles">
  {services.map((svc, index) => {
    const isEven = index % 2 === 1;
    return (
      <div id={svc.id} class="service-item grid scroll-mt-28 grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-x-16">
        <!-- Image -->
        <div
          class:list={["svc-media group relative aspect-[4/3] w-full bg-transparent", isEven ? "lg:order-2" : "lg:order-1"]}
        >
          <img
            src={`${baseUrl}${svc.image}`}
            alt={svc.imageAlt}
            class="absolute inset-0 h-full w-full object-cover object-center"
            loading={svc.number === '01' ? 'eager' : 'lazy'}
            onerror="this.remove()"
          />
        </div>

        <!-- Text Content -->
        <div class:list={["flex w-full max-w-[520px] flex-col gap-5", isEven ? "lg:order-1" : "lg:order-2"]}>
          <div>
            <span class="inline-block font-mono text-[13px] tracking-widest text-[var(--brand-fg)]">{svc.number}</span>
            <hr class="mt-2 h-[1px] w-[40px] border-0 bg-[rgba(57,255,20,0.3)]" />
          </div>
          <h2 class="text-[32px] font-semibold leading-tight tracking-tight text-white md:text-4xl">{svc.title}</h2>
          <p class="max-w-[460px] text-[16px] leading-relaxed text-zinc-300">{svc.description}</p>

          <hr class="h-px border-0 bg-[rgba(57,255,20,0.12)]" />

          <div class="grid grid-cols-[110px_1fr] items-start gap-4 max-sm:grid-cols-1 max-sm:gap-2">
            <span class="pt-1 font-mono text-[12px] uppercase tracking-[0.08em] text-zinc-400">Ideal para</span>
            <div class="flex flex-wrap gap-2">
              {svc.idealFor.map((item) => {
                return (
                  <span class="rounded-full border border-[rgba(57,255,20,0.3)] bg-transparent px-3 py-1.5 text-[13px] font-medium text-zinc-200">
                    {item}
                  </span>
                );
              })}
            </div>
          </div>

          <hr class="h-px border-0 bg-[rgba(57,255,20,0.12)]" />

          <div class="grid grid-cols-[110px_1fr] items-start gap-4 max-sm:grid-cols-1 max-sm:gap-2">
            <span class="pt-1 font-mono text-[12px] uppercase tracking-[0.08em] text-zinc-400">Incluye</span>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-3 max-sm:grid-cols-1">
              {svc.includes.map((item) => {
                return (
                  <li class="flex items-start gap-3 text-[15px] leading-relaxed text-zinc-200">
                    <svg class="mt-[3px] h-4 w-4 shrink-0 text-[var(--brand-fg)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-zinc-100">{item}</span>
                  </li>
                );
              })}
            </ul>
          </div>

          <hr class="h-px border-0 bg-[rgba(57,255,20,0.12)]" />

          <a
            href={whatsappUrl(svc.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Cotizar ${svc.title} por WhatsApp`}
            class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-6 text-base font-bold text-[#070B0A] transition-all duration-200 hover:brightness-95"
          >
            Cotizar este servicio
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    );
  })}
</div>

  <!-- CTA FINAL -->
  <section class="pt-section pb-section">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-base md:text-lg opacity-75 mb-6">¿No sabes cuál necesitas? Escríbeme y te recomiendo en 5 minutos.</p>
      <a
        href={whatsappUrl('Hola, no sé qué servicio me conviene. ¿Me ayudas a decidir?')}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribir por WhatsApp para ayuda eligiendo servicio"
        class="inline-flex items-center justify-center px-8 py-3.5 font-bold text-base rounded-xl bg-[var(--brand)] text-[#070B0A] hover:brightness-95 transition-all duration-200 shadow-[0_0_20px_var(--brand-glow)] hover:shadow-[0_0_25px_var(--brand-glow)]"
      >
        Escríbeme por WhatsApp
      </a>
    </div>
  </section>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll('nav[aria-label="Navegación de servicios"] a'));
  const rows = Array.from(document.querySelectorAll('.service-item'));
  const setActive = (id) => chips.forEach((c) => c.classList.toggle('chip-active', c.getAttribute('href') === `#${id}`));
  if ('IntersectionObserver' in window && rows.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    rows.forEach((r) => observer.observe(r));
  } else if (rows[0]) {
    setActive(rows[0].id);
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .chip-active {
    background-color: var(--brand-soft);
    color: var(--brand-fg);
  }

  /* Servicio: imagen flotante, sin caja. Solo contenedor de imagen. */
  .svc-media {
    --svc-fade-start: 14%;
    --svc-fade-end: 86%;
    --svc-glow-opacity: 0.12;
    --svc-glow-opacity-hover: 0.18;
    --svc-glow-blur: 50px;
    --svc-float-duration: 6s;
    background: transparent;
    border: 0;
    outline: 0;
    box-shadow: none;
    overflow: visible;
  }

  /* Luz ambiental detrás: elipse radial, sin forma de caja */
  .svc-media::before {
    content: "";
    position: absolute;
    inset: 12% 8%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(57, 255, 20, var(--svc-glow-opacity)) 0%, transparent 70%);
    filter: blur(var(--svc-glow-blur));
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .svc-media img {
    z-index: 1;
    border: 0;
    outline: 0;
    box-shadow: none;
    border-radius: 0;
    animation: svc-float var(--svc-float-duration) ease-in-out infinite alternate;
    transition: transform 300ms ease;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 var(--svc-fade-start), #000 var(--svc-fade-end), transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 var(--svc-fade-start), #000 var(--svc-fade-end), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 var(--svc-fade-start), #000 var(--svc-fade-end), transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 var(--svc-fade-start), #000 var(--svc-fade-end), transparent 100%);
    mask-composite: intersect;
  }

  @media (hover: hover) {
    .svc-media:hover img {
      animation: none;
      transform: translateY(-6px);
    }
    .svc-media:hover::before {
      background: radial-gradient(ellipse at center, rgba(57, 255, 20, var(--svc-glow-opacity-hover)) 0%, transparent 70%);
    }
  }

  @keyframes svc-float {
    from { transform: translateY(0); }
    to { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-media img {
      animation: none;
    }
  }
</style>