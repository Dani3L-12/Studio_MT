---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { WHATSAPP_NUMBER } from '../data/pricing';

// Prefijo del subdirectorio de despliegue ('' en raíz, '/Studio_MT' en GitHub Pages)
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
    {
      id: 'carta-digital',
      number: '01',
      title: 'Carta digital',
      description: 'Tu menú en una web que se abre con un QR. Tus clientes ven platos, fotos y precios, y te hacen el pedido directo por WhatsApp.',
      idealFor: ['Restaurantes', 'Cafeterías', 'Pollerías', 'Panaderías', 'Negocios de comida'],
      includes: [
        'Menú por categorías',
        'Fotos de tus platos',
        'Precios fáciles de actualizar',
        'Botón de pedido por WhatsApp',
        'QR listo para imprimir',
        'Diseño pensado para celular',
        'Mapa, horarios y contacto'
      ],
    demoHref: '/en-vivo/restaurante',
    image: '/images/services/carta.webp',
      imageAlt: 'Captura de una carta digital en un celular mostrando un menú de restaurante con platos, precios y botón de WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Carta digital para mi negocio. ¿Me das más información?'
    },
    {
      id: 'landing-page',
      number: '02',
      title: 'Landing page',
      description: 'Una página clara y rápida que presenta tu negocio, muestra tus servicios y lleva al cliente a escribirte o reservar.',
      idealFor: ['Barberías', 'Gimnasios', 'Consultorios', 'Academias', 'Servicios profesionales'],
      includes: [
        'Sección principal con tu propuesta',
        'Servicios y precios',
        'Galería de trabajos',
        'Botón de WhatsApp directo',
        'Mapa y horarios',
        'Diseño adaptado al celular'
      ],
    demoHref: '/en-vivo/landing-servicios',
    image: '/images/services/landing.webp',
      imageAlt: 'Captura de una landing page para una barbería mostrando servicios, precios y botón de WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Landing page para mi negocio. ¿Me das más información?'
    },
    {
      id: 'catalogo-web',
      number: '03',
      title: 'Catálogo web',
      description: 'Muestra tus productos en una web ordenada y recibe consultas al instante, sin que el cliente tenga que preguntar "¿qué tienes?".',
      idealFor: ['Tiendas de ropa', 'Ferreterías', 'Joyerías', 'Accesorios', 'Artesanías'],
      includes: [
        'Catálogo de hasta ~30 productos',
        'Categorías para encontrar rápido',
        'Foto, precio y descripción por producto',
        'Botón "Consultar" por WhatsApp en cada producto',
        'SEO básico',
        'Diseño pensado para celular'
      ],
      demoHref: '/en-vivo/catalogo',
      image: '/images/services/catalogo.webp',
      imageAlt: 'Captura de un catálogo web mostrando productos en categorías con fotos y precios',
      whatsappMessage: 'Hola, me interesa el servicio de Catálogo web para mi negocio. ¿Me das más información?'
    },
    {
      id: 'tienda-whatsapp',
      number: '04',
      title: 'Tienda con WhatsApp',
      description: 'Un carrito simple que termina en un mensaje de pedido armado en tu WhatsApp. Sin comisiones ni pasarelas complicadas.',
      idealFor: ['Delivery', 'Boutiques', 'Tiendas de regalos', 'Emprendimientos que venden por pedido'],
      includes: [
        'Catálogo con carrito',
        'Cantidades y total automático',
        'Pedido listo en tu WhatsApp',
        'Opción de entrega o recojo',
        'Versión en español e inglés',
        'Capacitación por Meet'
      ],
    demoHref: '/en-vivo/tienda',
    image: '/images/services/tienda.webp',
      imageAlt: 'Captura de una tienda con carrito mostrando productos, cantidades y botón de pedido por WhatsApp',
      whatsappMessage: 'Hola, me interesa el servicio de Tienda con WhatsApp para mi negocio. ¿Me das más información?'
    }
  ] as const;

  const whatsappUrl = (message: string) =>
    `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
---

<Layout title="Servicios" description="Webs simples, rápidas y pensadas para que tus clientes te escriban directo por WhatsApp.">
  <PageHeader title="Servicios" subtitle="Webs simples, rápidas y pensadas para que tus clientes te escriban directo por WhatsApp." />

  <!-- ANCHOR NAV -->
  <nav class="flex flex-wrap justify-center gap-3 mb-12 md:mb-16" aria-label="Navegación de servicios">
    {services.map((svc) => {
      return (
        <a
          href={`#${svc.id}`}
          class="chip px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 hover:bg-[var(--brand-soft)] hover:text-[var(--brand-fg)] focus:outline-none focus:ring-2 focus:ring-[var(--brand-fg)] focus:ring-offset-2 focus:ring-[#070B0A]"
          data-target={svc.id}
        >
          {svc.title}
        </a>
      );
    })}
  </nav>

  <!-- SERVICE ROWS -->
  <div class="flex flex-col gap-20 md:gap-24 max-w-[1100px] mx-auto" id="services-grid" role="list" aria-label="Servicios disponibles">
    {services.map((svc, index) => {
      const isEven = index % 2 === 1;
      return (
        <div id={svc.id} class="service-item grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-x-16 items-center scroll-mt-28">
          <!-- Image -->
          <div
            class:list={["group relative aspect-[4/3] rounded-2xl overflow-hidden bg-[var(--card-dark-bg)] shadow-2xl", isEven ? "lg:order-2" : "lg:order-1"]}
            style="isolation: isolate"
          >
            <img
              src={`${baseUrl}${svc.image}`}
              alt={svc.imageAlt}
              class="relative w-full h-full object-cover object-center group-hover:scale-103 transition-transform duration-500 soft-fade"
              loading={svc.number === '01' ? 'eager' : 'lazy'}
              onerror="this.remove()"
            />
          </div>

          <!-- Text Content -->
          <div class:list={["max-w-[480px]", isEven ? "lg:order-1" : "lg:order-2"]}>
            <span class="inline-block px-3 py-1 rounded-full bg-[var(--brand)] text-[#070B0A] text-xs font-bold font-mono mb-3">
              {index + 1 < 10 ? '0' : ''}{index + 1}
            </span>
            <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">{svc.title}</h2>
            <p class="text-lg opacity-80 leading-relaxed mb-8 max-w-[480px]">{svc.description}</p>

            <div class="flex flex-wrap gap-2 mb-8">
              {svc.idealFor.map((item) => {
                return (
                  <span class="chip px-3 py-1 rounded-full text-sm font-medium border border-[var(--brand-border)] text-[var(--brand-fg)] bg-transparent">
                    {item}
                  </span>
                );
              })}
            </div>

            <h3 class="text-lg font-semibold mb-4 text-[var(--brand-fg)]">Qué incluye</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
              {svc.includes.map((item) => {
                return (
                  <li class="flex items-center gap-3 text-base leading-relaxed text-zinc-200">
                    <svg class="w-5 h-5 shrink-0 text-[var(--brand-fg)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-zinc-100">{item}</span>
                  </li>
                );
              })}
            </ul>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={whatsappUrl(svc.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Cotizar ${svc.title} por WhatsApp`}
                class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 font-bold text-base rounded-xl bg-[var(--brand)] text-[#070B0A] hover:brightness-95 transition-all duration-200 shadow-[0_0_20px_var(--brand-glow)] hover:shadow-[0_0_25px_var(--brand-glow)]"
              >
                Cotizar este servicio
              </a>
              <a
                href={`${baseUrl}${svc.demoHref}`}
                class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 font-bold text-base rounded-xl border-2 border-[var(--brand-fg)] text-[var(--brand-fg)] hover:bg-[var(--brand)] hover:text-[#070B0A] transition-all duration-300"
              >
                Ver demo
              </a>
            </div>
      </div>
    </div>
    );
  })}
  </div>

  <!-- CTA FINAL -->
  <section class="py-20">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-base md:text-lg opacity-75 mb-6">¿No sabes cuál necesitas? Escríbeme y te recomiendo en 5 minutos.</p>
      <a
        href={whatsappUrl('Hola, no sé qué servicio me conviene. ¿Me ayudas a decidir?')}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribir por WhatsApp para ayuda eligiendo servicio"
        class="inline-flex items-center justify-center px-8 py-3.5 font-bold text-base rounded-xl bg-[var(--brand)] text-[#070B0A] hover:brightness-95 transition-all duration-200 shadow-[0_0_20px_var(--brand-glow)] hover:shadow-[0_0_25px_var(--brand-glow)]"
      >
        Escríbeme por WhatsApp
      </a>
    </div>
  </section>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll('nav[aria-label="Navegación de servicios"] a'));
  const rows = Array.from(document.querySelectorAll('.service-item'));
  const setActive = (id) => chips.forEach((c) => c.classList.toggle('chip-active', c.getAttribute('href') === `#${id}`));
  if ('IntersectionObserver' in window && rows.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    rows.forEach((r) => observer.observe(r));
  } else if (rows[0]) {
    setActive(rows[0].id);
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .chip-active {
    background-color: var(--brand-soft);
    color: var(--brand-fg);
  }

  /* Soft 4-side fade mask for images */
  .soft-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to left, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to top, transparent 0%, black 14%, black 86%, transparent 100%);
    -webkit-mask-composite: over;
    mask-image: linear-gradient(to bottom, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to left, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to top, transparent 0%, black 14%, black 86%, transparent 100%);
    mask-composite: intersect;
  }
</style>