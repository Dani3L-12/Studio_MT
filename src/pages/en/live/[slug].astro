---
import { demosData, type DemoItem } from '../../../data/demos';

export function getStaticPaths() {
  return demosData.map((demo) => {
    return {
      params: { slug: demo.slug },
      props: { demo },
    };
  });
}

interface Props {
  demo: DemoItem;
}

const { demo } = Astro.props;
const t = demo.en;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{t.name} — Live Demo (In Preparation)</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
		<style>
			body {
				background-color: #070B0A;
				color: #F1F7F5;
				font-family: 'Inter', sans-serif;
			}
			h1 {
				font-family: 'Space Grotesk', sans-serif;
			}
		</style>
	</head>
	<body class="min-h-screen flex items-center justify-center p-6 text-center">
		<!-- 
		  STAGE 8: Here each live demo will be built with its own unique visual style 
		  for the respective business type (restaurant, store, landing, etc.).
		-->
		<div class="max-w-md w-full p-8 rounded-2xl bg-[#070B0A]/70 backdrop-blur-md border border-[#00E5C3]/20 shadow-2xl space-y-6">
			<div class="text-4xl">🚧</div>
			<h1 class="text-2xl font-bold">Demo in Preparation</h1>
			<p class="text-sm opacity-75 leading-relaxed">
				The interactive demo for <strong class="text-[#39FF14]">{t.name}</strong> will be available soon.
			</p>
			<div>
				<a href={`/en/demos/${demo.slug}`} class="inline-block px-6 py-3 rounded-xl bg-[#39FF14] text-[#070B0A] font-bold text-sm hover:bg-[#32e011] transition-all">
					← Back to demo details
				</a>
			</div>
		</div>
	</body>
</html>
