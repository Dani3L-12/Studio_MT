---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import GlassCard from '../../components/GlassCard.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import ProcessSection from '../../components/ProcessSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import { servicesData } from '../../data/services';
import { en } from '../../i18n/en';

const getTranslation = (key: string) => {
  const keys = key.split('.');
  let obj: any = en;
  for (const k of keys) {
    obj = obj?.[k];
  }
  return obj || key;
};

const alwaysIncludedList = [
  en.alwaysIncluded.item1,
  en.alwaysIncluded.item2,
  en.alwaysIncluded.item3,
  en.alwaysIncluded.item4,
  en.alwaysIncluded.item5,
  en.alwaysIncluded.item6,
];
---

<Layout lang="en" title={en.pages.services.title} description={en.pages.services.subtitle}>
  <PageHeader title={en.servicesPage.headerTitle} subtitle={en.servicesPage.headerSubtitle} />

  <!-- DETAILED SERVICES -->
  <Section>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
      {servicesData.map((svc) => {
        const title = getTranslation(svc.titleKey);
        const desc = getTranslation(svc.descKey);
        const ideal = getTranslation(svc.idealKey);
        const includes = svc.includesKeys.map(k => getTranslation(k));

        return (
          <ServiceDetail 
            title={title}
            description={desc}
            idealText={ideal}
            includes={includes}
            iconSvg={svc.iconSvg}
            serviceName={title}
            lang="en"
          />
        );
      })}
    </div>

    <!-- WHAT'S ALWAYS INCLUDED -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-3 font-['Space_Grotesk']">
          {en.servicesPage.alwaysTitle}
        </h2>
        <p class="text-sm md:text-base opacity-80">{en.servicesPage.alwaysSubtitle}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {alwaysIncludedList.map((item, idx) => (
          <GlassCard class="p-6 flex flex-col items-start text-left">
            <div class="w-10 h-10 rounded-xl bg-[#39FF14]/10 text-[#39FF14] flex items-center justify-center font-mono font-bold text-sm mb-4">
              0{idx + 1}
            </div>
            <h3 class="font-bold text-base mb-1 font-['Space_Grotesk']">{item.title}</h3>
            <p class="text-xs sm:text-sm opacity-75">{item.desc}</p>
          </GlassCard>
        ))}
      </div>
    </div>
  </Section>

  <ProcessSection lang="en" />
  <CtaSection lang="en" />
</Layout>
