---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import GlassCard from '../../components/GlassCard.astro';
import Button from '../../components/Button.astro';
import { siteConfig } from '../../config/site.config';
import { en } from '../../i18n/en';

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappDefaultMsg)}`;
---

<Layout lang="en" title={en.contactPage.thanksTitle} description={en.contactPage.thanksSubtitle}>
  <head slot="head">
    <meta name="robots" content="noindex" />
  </head>

  <Section class="text-center py-32">
    <GlassCard class="max-w-lg mx-auto p-10 space-y-6">
      <div class="w-16 h-16 rounded-full bg-[#39FF14]/20 text-[#39FF14] flex items-center justify-center text-3xl mx-auto mb-4">
        ✓
      </div>
      <h1 class="text-3xl font-extrabold font-['Space_Grotesk']">{en.contactPage.thanksTitle}</h1>
      <p class="text-sm md:text-base opacity-80 leading-relaxed">{en.contactPage.thanksSubtitle}</p>
      
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <Button variant="primary" href={whatsappUrl} class="w-full justify-center">
          Chat on WhatsApp
        </Button>
        <Button variant="secondary" href="/en/" class="w-full justify-center">
          {en.contactPage.backHome}
        </Button>
      </div>
    </GlassCard>
  </Section>
</Layout>
